---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/app.css';
import { icon } from '../scripts/icons';
import { readFileSync } from 'node:fs';
import interFont from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import bricolageFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
// Inlined so iOS can read it without a login cookie (it fetches the icon itself, which a password-protected site answers with 401).
const touchIcon = 'data:image/png;base64,' + readFileSync('public/icons/apple-touch-icon.png').toString('base64');
// Link previews (chat apps, social) need a full address for the image: Netlify gives the site's main address as URL while it builds (a local build has none, so the path stays relative).
const site = (process.env.URL ?? '').replace(/\/$/, '');
const FIELDS = ['Design', 'Writing', 'Code', 'Video', 'Selling', 'Music', 'Prompting'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>KERN · Don't guess your passion. Test it.</title>
    <meta name="description" content="Try short missions in design, writing, code, video, selling and music, with an AI co-pilot that only asks questions. Find your passion by testing different paths. Free, no account." />
    <meta name="theme-color" content="#0F140E" />
    <link rel="preload" as="font" type="font/woff2" href={interFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bricolageFont} crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={touchIcon} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="KERN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="KERN" />
    <meta property="og:description" content="Try short missions in design, writing, code, video, selling and music, with an AI co-pilot that only asks questions. Find your passion by testing different paths. Free, no account." />
    <meta property="og:image" content={`${site}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Don't guess your passion. Test it." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="k-scr" id="kScr">
      <h1 class="k-sr">KERN</h1>
      <div class="k-load" id="kLoad" aria-hidden="true">
        <div class="k-ic"><img src="/img/mark.webp" alt="" width="108" height="108" fetchpriority="high" /></div>
        <div class="k-tag"><span>Don’t guess your passion.</span><strong>Test it.</strong></div>
      </div>

      <div class="k-sheet" id="kSheet" role="dialog" aria-modal="true" aria-labelledby="kShT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <div class="k-shbar">
            <div class="k-prog" id="kProg" role="progressbar" aria-label="Mission progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><i><b></b></i><i><b></b></i><i><b></b></i></div>
            <div class="k-shh"><button type="button" class="k-shx" id="kShX" aria-label="Close"><svg class="k-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></button><div class="k-l" id="kShL">Mission 002 · startup partner</div></div>
          </div>
          <h5 id="kShT">Fix what already exists</h5>
          <div class="k-step" id="kShA">
            <div class="k-x" id="kShX">
              <div class="k-xm"><span class="k-l" id="kXWho"></span><span class="k-l" id="kXMin"></span></div>
              <div class="k-boost-chip" id="kXBoost" hidden></div>
              <p class="k-xb" id="kXBrief"></p>
              <div class="k-xa"><div class="k-l" id="kXAT"></div><img class="k-xi" id="kXAI" alt="" hidden decoding="async" /><pre id="kXAB"></pre></div>
            </div>
            <p class="k-l k-coop-hint" id="kCoopHint" hidden>Co-op mission: answer it, then send it to a friend to finish together.</p>
            <div class="k-compose" id="kCompose">
              <p class="k-msg k-ai" id="kShQ">What would make the first step easier for someone brand new?</p>
              <label class="k-l" for="kTa">Your answer</label>
              <textarea id="kTa" rows="4" maxlength="2000"></textarea>
              <p class="k-rf-note" id="kSaved" aria-live="polite">It stays on this device unless you ask KERN.AI.</p>
              <div class="k-sh-btns"><button type="button" class="k-go" id="kSub">Submit answer</button><button type="button" class="k-sk" id="kCancel">Not now</button></div>
            </div>
            <div class="k-x" id="kShH">
              <p class="k-msg k-ai" id="kXFirst" hidden>First time here? Write yours above, or use the example, the hints and the steps below. Too hard? Tap “Make it easier”.</p>
              <div class="k-xbtns" id="kXBtns"><button type="button" class="k-chipb" id="kXEx" aria-expanded="false" aria-controls="kXExB">Show an example</button><button type="button" class="k-chipb" id="kXHint">Need a hint?</button><button type="button" class="k-chipb k-ai-btn" id="kXAsk">Ask KERN.AI</button><button type="button" class="k-chipb" id="kXEasy">Make it easier</button></div>
              <div class="k-xex" id="kXExB" hidden><div class="k-l">A strong answer, for inspiration</div><pre id="kXExT"></pre></div>
              <div id="kXHints" aria-live="polite"></div>
              <div class="k-xh"><span class="k-l" id="kXSL">Your steps</span><span class="k-l" id="kXPn" aria-live="polite"></span></div>
              <div class="k-xp" aria-hidden="true"><i id="kXPb"></i></div>
              <div id="kXSteps" role="group" aria-labelledby="kXSL"></div>
            </div>
            <div class="k-trailsigns"><div class="k-l">Reviews from people before you</div><div id="kShS" aria-live="polite"></div></div>
          </div>
          <div class="k-step k-drop" id="kShD" hidden>
            <div class="k-dr-stage"><div class="k-dr-bits" id="kDrBits" aria-hidden="true"></div><div class="k-dr-art" id="kDrArt"></div></div>
            <div class="k-l" id="kDrL">You found</div>
            <h5 id="kDrT"></h5>
            <p class="k-dr-n" id="kDrN" aria-live="polite"></p>
            <p class="k-l" id="kDrS"></p>
            <p class="k-dr-nx" id="kDrNx" hidden></p>
            <div class="k-sh-btns"><button type="button" class="k-go" id="kDrOk" aria-describedby="kDrT kDrN kDrS kDrNx">Keep going</button><button type="button" class="k-sk" id="kDrCoop" aria-describedby="kDrCoN" hidden>Finish it with a friend</button></div>
            <p class="k-l" id="kDrCoN" hidden>The link carries your answer, so it is only as private as the chat you send it to.</p>
          </div>
          <div class="k-step" id="kShR" hidden>
            <div class="k-l">Quick reflection · 20 seconds</div>
            <p class="k-q" id="kRfEQ">How did it feel?</p>
            <div class="k-chips" id="kRfE" role="group" aria-labelledby="kRfEQ"><span role="button" tabindex="0" data-v="flow">Time flew</span><span role="button" tabindex="0" data-v="ok">It was fine</span><span role="button" tabindex="0" data-v="drag">It dragged</span></div>
            <p class="k-q" id="kRfAQ">Would you do this kind of task again?</p>
            <div class="k-chips" id="kRfA" role="group" aria-labelledby="kRfAQ"><span role="button" tabindex="0" data-v="yes">Yes</span><span role="button" tabindex="0" data-v="maybe">Maybe</span><span role="button" tabindex="0" data-v="no">No</span></div>
            <label class="k-l" for="kRfH">Hardest part (optional)</label><input id="kRfH" type="text" maxlength="140" autocomplete="off" />
            <label class="k-l" for="kRfT">Leave a review for the next person (optional)</label><input id="kRfT" type="text" maxlength="140" autocomplete="off" aria-describedby="kRfN" /><p class="k-rf-note" id="kRfN"></p>
            <div id="kRfBar" class="k-cut" hidden>
              <div class="k-l" id="kRfBL">Check your answer · +10 stones each</div>
              <p class="k-rf-note" id="kRfShort" hidden>Bonus stones and finds start from 20 characters. This answer is a bit short.</p>
              <div id="kRfBI" role="group" aria-labelledby="kRfBL"></div>
            </div>
            <div class="k-sh-btns"><button type="button" class="k-go" id="kRfOk">Save</button><button type="button" class="k-sk" id="kRfSkip">Skip</button></div>
          </div>
        </div>
      </div>

      <div class="k-sheet" id="kSet" role="dialog" aria-modal="true" aria-labelledby="kSetT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <h5 id="kSetT" class="k-top-zone">Settings</h5>
          <div class="k-row"><span class="k-l" id="kLgL">Language</span><div class="k-seg" role="group" aria-labelledby="kLgL"><button type="button" data-k-lang="en" lang="en" aria-label="English">EN</button><button type="button" data-k-lang="it" lang="it" aria-label="Italiano">IT</button></div></div>
          <div class="k-row"><span class="k-l" id="kThL">Theme</span><div class="k-seg" role="group" aria-labelledby="kThL"><button type="button" data-k-theme="dark">Dark</button><button type="button" data-k-theme="light">Light</button></div></div>
          <div class="k-row"><span class="k-l" id="kTxL">Text size</span><div class="k-seg k-txt" role="group" aria-labelledby="kTxL"><button type="button" data-k-text="0" aria-label="Small">A</button><button type="button" data-k-text="1" aria-label="Default">A</button><button type="button" data-k-text="2" aria-label="Large">A</button><button type="button" data-k-text="3" aria-label="Larger">A</button></div></div>
          <div class="k-acct" id="kAcct" hidden>
            <span class="k-l">Account</span>
            <p id="kAcctE">Not signed in · your trail is only on this device</p>
            <div class="k-btnrow">
              <button type="button" class="k-ask-btn" id="kAcctUp">Create an account to save your trail</button>
              <button type="button" class="k-ask-btn" id="kLogout" hidden>Log out</button>
            </div>
          </div>
          <div class="k-set-list">
            <button type="button" class="k-ask-btn" data-k-send>Share my trail with the KERN team</button>
            <button type="button" class="k-ask-btn" id="kRemind">Add a weekly reminder to my calendar</button>
            <button type="button" class="k-ask-btn" data-k-copy="app">Copy app link</button>
            <button type="button" class="k-ask-btn" id="kFeed">Send feedback</button>
            <button type="button" class="k-ask-btn" id="kChField">Your interests</button>
            <button type="button" class="k-ask-btn" id="kInst" hidden>Install KERN</button>
            <p class="k-l" id="kIos" hidden>On iPhone: tap Share, then Add to Home Screen.</p>
            <button type="button" class="k-ask-btn" id="kStatSet" hidden>Usage counts: off</button>
            <button type="button" class="k-ask-btn" id="kExp">Export my data</button>
            <button type="button" class="k-ask-btn k-danger" id="kDel">Delete my data</button>
            <button type="button" class="k-ask-btn k-danger" id="kDelAcc" hidden>Delete my account</button>
          </div>
          <p class="k-l">Missions are samples while partners join.</p>
          <p class="k-l"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · KERN 1.0</p>
          <button type="button" class="k-go" id="kSetX">Close</button>
        </div>
      </div>

      <div class="k-sheet" id="kFld" role="dialog" aria-modal="true" aria-labelledby="kFlT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <div class="k-fl-h k-top-zone"><span class="k-fl-i" id="kFlI" aria-hidden="true"></span><div><div class="k-l">What to expect</div><h5 id="kFlT"></h5></div></div>
          <div class="k-l">A day in it</div>
          <p class="k-fl-day" id="kFlD"></p>
          <div class="k-fl-cols">
            <div><div class="k-l">People like</div><ul id="kFlL"></ul></div>
            <div><div class="k-l">People find hard</div><ul id="kFlH"></ul></div>
          </div>
          <p class="k-l">First impressions from the missions, not a verdict.</p>
          <button type="button" class="k-go" id="kFlGo">Try the next mission</button>
          <button type="button" class="k-sk" id="kFlX">Close</button>
        </div>
      </div>

      <div class="k-sheet" id="kPwS" role="dialog" aria-modal="true" aria-labelledby="kPwT" hidden>
        <form class="k-sh-in" id="kPwF" novalidate>
          <div class="k-grab" aria-hidden="true"></div>
          <h5 id="kPwT" class="k-top-zone">Set a new password</h5>
          <div class="k-field"><label class="k-l" for="kPwN">New password</label><input id="kPwN" type="password" minlength="8" maxlength="72" autocomplete="new-password" /></div>
          <p class="k-err" id="kPwErr" role="alert" hidden></p>
          <button type="submit" class="k-go">Save password</button>
        </form>
      </div>

      <div class="k-reward" id="kReward" role="dialog" aria-modal="true" aria-labelledby="kRwT" hidden>
        <div class="k-conf" id="kConf" aria-hidden="true"></div>
        <div class="k-rw-in">
          <div class="k-medal" aria-hidden="true">#1</div>
          <div class="k-l">Voted first</div>
          <h4 id="kRwT">Your answer<br>won <b>#1.</b></h4>
          <p>Preview: this is what it looks like when reviewers rank your answer first.</p>
          <div class="k-gain"><b id="kGain">+0</b> <span class="k-l">stones</span></div>
          <div class="k-rankup" id="kRU" hidden><div><div class="k-l">New rank</div><div class="k-rank" id="kRU2"></div></div></div>
          <button type="button" class="k-go" id="kRwOk">Keep going</button>
        </div>
      </div>

      <div class="k-start" id="kLogin">
        <form class="k-sp" id="kProf" novalidate>
          <img class="k-mark" src="/img/mark.webp" alt="" width="84" height="84" />
          <div class="k-l">Welcome</div>
          <h4>Start your<br><b>trail.</b></h4>
          <div class="k-seg k-authseg" id="kAuthSeg" role="group" aria-label="Account" hidden><button type="button" data-k-mode="up">Create account</button><button type="button" data-k-mode="in">Log in</button></div>
          <div class="k-field" id="kFName"><label class="k-l" for="kNmI">Your name</label><input id="kNmI" type="text" maxlength="40" autocomplete="given-name" aria-required="true" /></div>
          <div class="k-field" id="kFEmail" hidden><label class="k-l" for="kEm">Email</label><input id="kEm" type="email" maxlength="254" autocomplete="email" inputmode="email" aria-required="true" /></div>
          <div class="k-field" id="kFPw" hidden><label class="k-l" for="kPw">Password</label><input id="kPw" type="password" minlength="8" maxlength="72" autocomplete="new-password" aria-required="true" /></div>
          <label class="k-check" id="kFAge"><input type="checkbox" id="kAge" aria-required="true" /><span>I am 18 or older</span></label>
          <p class="k-err" id="kErr" role="alert" hidden></p>
          <p class="k-okm" id="kOk" role="status" hidden></p>
          <button type="submit" class="k-go" id="kLog">Start</button>
          <button type="button" class="k-sk" id="kForgot" hidden>Forgot password?</button>
          <button type="button" class="k-sk" id="kGuest" hidden>Continue without an account</button>
          <p class="k-l" id="kNoteLocal">No account needed yet. Your trail stays on this device. <a href="/privacy/">Privacy</a></p>
          <p class="k-l" id="kNoteCloud" hidden>Your trail is saved to your account and synced across your devices. <a href="/privacy/">Privacy</a></p>
        </form>
      </div>

      <div class="k-start" id="kStart" role="dialog" aria-modal="true" aria-labelledby="kS1H">
        <div id="kS1" class="k-sp">
          <img class="k-mark" src="/img/mark.webp" alt="" width="84" height="84" />
          <div class="k-l">Start here</div>
          <h4 id="kS1H">What do you want<br>to <b>try?</b></h4>
          <p class="k-promise">Try short missions in seven different fields and see which path clicks. Free, no account.</p>
          <ol class="k-how">
            <li><b>01</b><p>Try a short mission</p></li>
            <li><b>02</b><p>Reflect in 20 seconds</p></li>
            <li><b>03</b><p>See how you work</p></li>
          </ol>
          <button type="button" class="k-go" id="kIdk">I don't know yet</button>
          <button type="button" class="k-sk" id="kSkip">Explore missions</button>
        </div>
        <div id="kS2" class="k-sp" hidden>
          <div class="k-l" id="kS2K">Good. Let's find out.</div>
          <h4 id="kS2H">What are you<br>curious about <b>right now?</b></h4>
          <p class="k-l" id="kPickL">Pick one or more. You can add others anytime.</p>
          <div class="k-tiles" id="kPick" role="group" aria-labelledby="kPickL">
            {FIELDS.map((f) => <button type="button" class="k-tile" data-f={f} aria-pressed="false"><span class="k-ti" aria-hidden="true" set:html={icon(f)} /><span>{f}</span></button>)}
          </div>
          <button type="button" class="k-go" id="kGo">Start my first mission</button>
          <button type="button" class="k-sk" id="kPickX" hidden>Not now</button>
        </div>
      </div>

      <div class="k-app">
        <header class="k-top">
          <div class="k-logo"><img src="/img/mark.webp" alt="" width="28" height="28" />kern<i>.</i></div>
          <div class="k-tp"><button type="button" class="k-demo" id="kDemo" aria-label="Demo profile with sample data. Tap to leave the demo." hidden>Demo</button><span class="k-pill"><i class="k-ring" id="kRing" aria-hidden="true"></i><span id="kPill">0 of 3 done</span></span><button type="button" class="k-av" id="kAv" aria-label="Settings" aria-haspopup="dialog">K</button></div>
        </header>
        <div class="k-body">
          <section class="k-pane on" id="k-missions">
            <div><div class="k-l" id="kHi">Hi</div><h4>Pick your<br>next <b>move.</b></h4></div>
            <div class="k-streak k-cut" id="kStreak" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-6 1-9z"/></svg><b id="kStreakT"></b><small>A missed day is forgiven.</small></div>
            <div class="k-fields" id="kFields" role="group" aria-label="Your interests"></div>
            <button type="button" class="k-sk k-about" id="kAbout" aria-haspopup="dialog"></button>
            <div class="k-card k-coop" id="kCoop" hidden>
              <div class="k-l" id="kCoL"></div>
              <h5 id="kCoT"></h5>
              <div class="k-coq"><div class="k-l" id="kCoQL"></div><p id="kCoQ"></p></div>
              <div class="k-l">Your part</div>
              <p id="kCoAsk"></p>
              <label class="k-sr" for="kCoTa">Your reply</label>
              <textarea id="kCoTa" rows="3" maxlength="300"></textarea>
              <div class="k-btnrow"><button type="button" class="k-go" id="kCoSend">Send back</button><button type="button" class="k-sk" id="kCoSelf">Do the mission yourself</button><button type="button" class="k-sk" id="kCoNo">Not now</button></div>
            </div>
            <div class="k-card k-dare" id="kDare" hidden><div class="k-l">A friend dared you</div><h5 id="kDareT"></h5><button type="button" class="k-go" id="kDareGo">Answer the dare</button></div>
            <div class="k-card k-main" id="kNext"><span class="k-nxic" id="kNxIc" aria-hidden="true"></span><div class="k-l" id="kNxL">Your next step</div><h5 id="kNxT">Fix what already exists</h5><p id="kNxP">Make a real startup's onboarding screen clearer. The opposite of starting from a blank page.</p><div class="k-meta" id="kNxM"></div><div class="k-boost-chip" id="kNxB" hidden></div><button type="button" class="k-btn" id="kAdd">Add your answer</button><button type="button" class="k-sk" id="kAdd2" hidden></button></div>
            <div class="k-card k-stat" id="kStat" hidden><div class="k-l">Help improve KERN</div><p>Count my progress, without my name? We only see which missions you open and finish, when you come back, and whether you use Share or KERN.AI. Never your name, your answers or your email.</p><div class="k-btnrow"><button type="button" class="k-ask-btn" id="kStY">Yes, count me in</button><button type="button" class="k-ask-btn" id="kStN">No thanks</button></div><div><a class="k-l" href="/privacy/">What is counted?</a></div></div>
            <div class="k-card"><div class="k-l" id="kMsL">Your 3 missions</div>
              <div class="k-mlist">
                <button type="button" class="k-mrow" id="kMR0"><i class="k-mdot" aria-hidden="true"></i><span><b>Fix what already exists</b><small></small></span><em aria-hidden="true">›</em></button>
                <button type="button" class="k-mrow" id="kMR1"><i class="k-mdot" aria-hidden="true"></i><span><b>Rewrite a confusing email</b><small></small></span><em aria-hidden="true">›</em></button>
                <button type="button" class="k-mrow" id="kMR2"><i class="k-mdot" aria-hidden="true"></i><span><b>Work with a partner</b><small></small></span><em aria-hidden="true">›</em></button>
              </div>
              <button type="button" class="k-sk k-peek" id="kPeek" hidden></button>
            </div>
            <div class="k-card k-habit k-cut" id="kHabit">
              <div class="k-l k-finds-h"><span>Daily habit · tiny on purpose</span><span id="kHbN"></span></div>
              <div id="kHbSet">
                <h5>Start one tiny habit</h5>
                <p>Make it so small you cannot fail. Tie it to something you already do every day, and it sticks.</p>
                <div class="k-chips" id="kHbPick"></div>
                <label class="k-l" for="kHbT">Your tiny habit</label><input id="kHbT" type="text" maxlength="60" autocomplete="off" />
                <div class="k-chips" id="kHbCues"></div>
                <label class="k-l" for="kHbC">Right after I…</label><input id="kHbC" type="text" maxlength="60" autocomplete="off" />
                <button type="button" class="k-btn" id="kHbSave">Start my habit</button>
              </div>
              <div id="kHbRun" hidden>
                <h5 id="kHbName"></h5>
                <p id="kHbCue"></p>
                <div class="k-hb-dots" id="kHbDots" role="group" aria-label="Last 7 days"></div>
                <div class="k-sh-btns"><button type="button" class="k-go" id="kHbDo">I did it</button><button type="button" class="k-sk" id="kHbEdit">Change habit</button></div>
                <p class="k-l" id="kHbMsg" aria-live="polite"></p>
              </div>
            </div>
            <div class="k-card k-best k-cut"><div class="k-l">Coming with partner missions</div><h5>Anonymous review</h5><p>Reviewers rank answers by quality, not likes. The best ones get seen by the company behind the mission.</p><button type="button" class="k-win" id="kWin">See what a win feels like</button></div>
            <div class="k-card k-aic"><span class="k-ci" aria-hidden="true" set:html={icon('copilot')} /><div class="k-l">Stuck?</div><p>KERN.AI asks the questions that get you moving. It never gives you the answer.</p><button type="button" class="k-ask-btn" id="kToAi">Open KERN.AI</button></div>
          </section>

          <section class="k-pane" id="k-yourkern">
            <div><div class="k-l">yourKERN · first signs</div><h4>Your <b>KERN</b><br>so far.</h4></div>
            <div class="k-card k-kcard" id="kKernCard"><div class="k-l">Your Kern card</div><div class="k-kc"><img class="k-kc-img" src="/img/cairn.webp" alt="" width="720" height="720" loading="lazy" decoding="async" /><div class="k-kt">kern<i>.</i></div><h5 id="kCardH">You light up when you start from zero.</h5><div class="k-chips" id="kCardC"><span>Shaping ideas</span><span>Writing</span></div><div class="k-l" id="kCardL">Example · answer and reflect to make it yours</div></div><div class="k-btnrow"><button type="button" class="k-ask-btn" data-k-share="card">Share my card</button><button type="button" class="k-ask-btn" data-k-copy="app">Copy app link</button></div></div>
            <div class="k-card" id="kFcmp" hidden><div class="k-l">Fields side by side</div><h5 id="kFcmpT"></h5><div class="k-meter" id="kFcmpM"></div><p class="k-l">Energy from how it felt, and how many reflections it rests on. Your own answers, not a test.</p></div>
            <div class="k-card" id="kCoops" hidden><div class="k-l">Co-op with a friend</div><p>Two missions in every field work with a friend. Answer one, send the link, and read both answers here.</p><div id="kCoopL"></div></div>
            <div class="k-card k-further" id="kFurther" hidden><div class="k-l" id="kFuL"></div><h5>Three steps outside the app</h5><ol class="k-fu" id="kFuO"></ol><p class="k-l">Small and free. Pick one this week.</p></div>
            <div class="k-card k-lvl k-cut"><div class="k-lvl-top"><div><div class="k-l">Your rank</div><div class="k-rank" id="kRank">Pebble</div></div><div class="k-stones"><b id="kSt">0</b> <span class="k-l">stones</span></div></div><div class="k-bar k-bar-g"><i id="kBar"></i></div><small class="k-nx" id="kNx"></small><div class="k-ladder" id="kLad"></div></div>
            <div class="k-l k-note" id="kSample">Signals below are examples until you answer and reflect.</div>
            <div class="k-card"><div class="k-l">A first guess</div><div class="k-sig" id="kGuess">You seemed to light up on the open brief and drag on the polish.</div><div class="k-l" id="kWhy">Why we think so: you tried 3 versions of the open brief, and you wrote "time flew".</div>
              <div class="k-ask"><button type="button" class="k-yes" data-k-msg="Saved. This sharpens your KERN.">That feels right</button><button type="button" data-k-msg="Noted. We'll give this guess less weight.">Not really</button></div><div class="k-l k-fb" id="kFb" aria-live="polite"></div></div>
            <div class="k-card"><div class="k-l">What you light up on</div><div class="k-meter" id="kMeter"></div><p class="k-l" id="kMeterN">From your reflections. Not a test.</p></div>
            <div class="k-card"><div class="k-l">What you seem drawn to</div><div class="k-chips" id="kDrawn"><span>Shaping ideas</span><span>Writing</span><span>Solo work</span></div></div>
            <div class="k-card"><div class="k-l">How you work with AI</div><div class="k-sig" id="kAiSig">You rewrote your question 4 times, and every version got clearer.</div></div>
            <div class="k-card k-cut"><div class="k-l k-finds-h"><span>Finds</span><span id="kFN"></span></div><div class="k-finds" id="kFinds"></div><p class="k-l">Finish missions to uncover them. You never know which one drops.</p></div>
            <div class="k-card k-cut"><div class="k-l" id="kBdL">Badges</div><div class="k-badges" id="kBadges" role="group" aria-labelledby="kBdL"></div></div>
            <div class="k-card"><div class="k-l">Your answers</div><div id="kAns"></div></div>
            <div class="k-duo k-cut"><div class="k-card"><div class="k-l">Answers made</div><div class="k-stat"><b id="kCnt">0</b></div><span class="k-l">on this device · only you see this</span></div><div class="k-card"><div class="k-l">Your rhythm · no pressure</div><div class="k-cal" id="kDots" aria-hidden="true"></div><p id="kRhy"></p></div></div>
            <div class="k-card k-signs-card"><div class="k-l">Reviews on the trail</div><p>People who finish a mission before you leave a short tip for you. Yours helps the next person.</p><div class="k-l">Reviews you left</div><div id="kSigns"></div></div>
            <div class="k-card"><div class="k-l">Dare a friend</div><p>Send a mission to a friend, and answer it on your own. For two answers side by side, use a co-op mission.</p><div class="k-btnrow"><button type="button" class="k-ask-btn" data-k-share="dare">Send a dare</button><button type="button" class="k-ask-btn" data-k-copy="dare">Copy link</button></div></div>
            <div class="k-card k-pilot k-cut"><div class="k-l">Testing KERN?</div><p>Send your answers and reflections to the team. It helps us build the next version.</p><button type="button" class="k-ask-btn" data-k-send>Share my trail with the KERN team</button></div>
                      </section>

          <section class="k-pane" id="k-trail" hidden>
            <div class="k-hd"><div class="k-l">Your Trail</div><h4>Follow the<br><b>trail.</b></h4></div>
            <div class="k-tr" id="kTr" role="list">
              <div class="k-st" role="listitem"><h5 id="kTr0">Fix what already exists</h5><p>Not started</p></div>
              <div class="k-st" role="listitem"><h5 id="kTr1">Rewrite a confusing email</h5><p>Not started</p></div>
              <div class="k-st" role="listitem"><h5 id="kTr2">Work with a partner</h5><p>Not started</p></div>
              <div class="k-st" id="kTrK" role="listitem"><h5>Your Kern card</h5><p>Ready when your 3 missions are done</p></div>
            </div>
          </section>

          <section class="k-pane" id="k-copilot">
            <div class="k-hd"><div class="k-l">KERN.AI · your co-pilot</div><h4>Your idea.<br>My <b>questions.</b></h4></div>
            <div class="k-ait"><span class="k-ci" aria-hidden="true" set:html={icon('copilot')} /><div class="k-l" id="kAiLbl">You are talking to an AI · live when online</div></div>
            <p class="k-l" id="kAiDemo" hidden>Demo: what you type here is sent to the AI to get a reply. We do not store it.</p>
            <div class="k-card k-chat">
              <div class="k-log" id="kChat"></div><div class="k-sr" id="kSr" role="status" aria-live="polite"></div>
              <div class="k-cmp" id="kCmp" hidden><div class="k-l">Version 1</div><p id="kV1"></p><div class="k-l">Version 3</div><p id="kV3"></p><button type="button" class="k-ask-btn" id="kSaveV">Save to yourKERN</button></div>
              <div class="k-comp"><input id="kIn" type="text" maxlength="140" autocomplete="off" aria-label="Your idea" /><button type="button" class="k-send" id="kSend" aria-label="Send">↑</button></div>
              <div class="k-chips" id="kEx"><span role="button" tabindex="0">Use an example</span><span role="button" tabindex="0">Start over</span><span role="button" tabindex="0">I’m stuck</span><span role="button" tabindex="0">Make it smaller</span></div>
            </div>
            <div class="k-card k-cut"><div class="k-l">Do it twice</div><p>Make it alone first. Then with the co-pilot. Compare the two.</p></div>
            <div class="k-card"><div class="k-l">The rules</div><p>It asks. It never answers.</p><p>Your idea always comes first.</p><p>If it gets heavy, it stops and points you to a person.</p></div>
          </section>
        </div>
        <div class="k-toast" id="kToast" role="status" aria-live="polite"><span id="kToastT"></span><button type="button" id="kToastB" hidden>Undo</button></div>
        <nav class="k-tabs" aria-label="KERN">
          <button type="button" class="on" data-k-tab="missions"><span class="ti" set:html={icon('missions') + icon('missions-on', 'k-i k-on')} /><span class="tn tt">Missions</span></button>
          <button type="button" data-k-tab="yourkern"><span class="ti" set:html={icon('yourkern')} /><span class="tn"><b class="tl">your<span>KERN</span></b></span></button>
          <button type="button" data-k-tab="copilot"><span class="ti" set:html={icon('copilot')} /><span class="tn tt">KERN.AI</span></button>
        </nav>
      </div>
    </main>
    <noscript><p class="k-nojs">KERN needs JavaScript to run.</p></noscript>
    <script>import '../scripts/app';</script>
  </body>
</html>
